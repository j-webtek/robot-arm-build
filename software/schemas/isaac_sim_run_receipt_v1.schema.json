{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/isaac_sim_run_receipt_v1.schema.json",
  "title": "Tactevra Isaac Sim run receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "request_id", "request_sha256", "evidence_class", "toolchain",
    "execution", "import_parity", "tracking", "geometry", "contact", "vision",
    "differential", "reproducibility", "status", "reason_codes", "limitations",
    "wire_commands", "hardware_access", "physical_authority", "gate_promotions",
    "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.isaac_sim_run_receipt.v1"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_class": {"enum": ["CONTRACT_TEST_ONLY", "ISAAC_SIM_ADVISORY"]},
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["isaac_sim_version", "installation_sha256", "backend"],
      "properties": {
        "isaac_sim_version": {"type": "string", "minLength": 1},
        "installation_sha256": {"$ref": "#/$defs/sha256"},
        "backend": {"enum": ["FAKE", "ISAAC_SIM"]}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["step_count", "time_step_s", "substeps", "random_seed", "gpu", "driver", "renderer", "physics_backend"],
      "properties": {
        "step_count": {"type": "integer", "minimum": 0},
        "time_step_s": {"type": "number", "exclusiveMinimum": 0},
        "substeps": {"type": "integer", "minimum": 1},
        "random_seed": {"type": "integer", "minimum": 0},
        "gpu": {"type": "string", "minLength": 1},
        "driver": {"type": "string", "minLength": 1},
        "renderer": {"type": "string", "minLength": 1},
        "physics_backend": {"type": "string", "minLength": 1}
      }
    },
    "import_parity": {"type": "object"},
    "tracking": {"type": "object"},
    "geometry": {"type": "object"},
    "contact": {"type": "object"},
    "vision": {"type": "object"},
    "differential": {"type": "object"},
    "reproducibility": {
      "type": "object", "additionalProperties": false,
      "required": ["result_signature_sha256", "repeat_index"],
      "properties": {
        "result_signature_sha256": {"$ref": "#/$defs/sha256"},
        "repeat_index": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["PASS", "REJECT", "ERROR"]},
    "reason_codes": {"$ref": "#/$defs/uniqueStrings"},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "wire_commands": {"type": "array", "maxItems": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "gate_promotions": {"type": "array", "maxItems": 0},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "uniqueStrings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}

