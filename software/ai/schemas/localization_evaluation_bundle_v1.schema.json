{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/localization_evaluation_bundle_v1.schema.json",
  "title": "Held-out synthetic localization evaluation bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "scope", "model_id", "model_checkpoint_sha256",
    "target_catalog_sha256", "calibration_dataset_sha256",
    "evaluation_dataset_sha256", "domain_id", "sampling_unit",
    "covered_target_ids", "declared_coverage_probability",
    "measured_coverage_probability", "conservative_planar_error_bound_mm",
    "calibration_sample_count", "evaluation_sample_count", "per_target",
    "qualification_candidate", "qualification_installed",
    "physical_deployment_qualified", "hardware_writes", "physical_movements",
    "limitations", "bundle_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.ai_localization_evaluation_bundle.v1"},
    "scope": {"const": "SYNTHETIC_OFFLINE_ONLY"},
    "model_id": {"$ref": "#/$defs/identifier"},
    "model_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "target_catalog_sha256": {"$ref": "#/$defs/sha256"},
    "calibration_dataset_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_dataset_sha256": {"$ref": "#/$defs/sha256"},
    "domain_id": {"$ref": "#/$defs/identifier"},
    "sampling_unit": {
      "const": "scene_style_condition_maximum_across_covered_targets"
    },
    "covered_target_ids": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "declared_coverage_probability": {
      "type": "number", "minimum": 0.95, "exclusiveMaximum": 1
    },
    "measured_coverage_probability": {
      "type": "number", "minimum": 0, "maximum": 1
    },
    "conservative_planar_error_bound_mm": {
      "type": "number", "exclusiveMinimum": 0, "maximum": 100
    },
    "calibration_sample_count": {"type": "integer", "minimum": 1},
    "evaluation_sample_count": {"type": "integer", "minimum": 1},
    "per_target": {
      "type": "object", "minProperties": 1, "maxProperties": 256,
      "additionalProperties": {"$ref": "#/$defs/target_result"}
    },
    "qualification_candidate": {
      "anyOf": [
        {"$ref": "localization_qualification_v0.schema.json"},
        {"type": "null"}
      ]
    },
    "qualification_installed": {"const": false},
    "physical_deployment_qualified": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "target_result": {
      "type": "object", "additionalProperties": false,
      "required": [
        "sample_count", "error_series_sha256", "failure_count", "failure_case_ids",
        "abstention_count", "maximum_error_mm", "mean_error_mm",
        "p95_error_mm"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1},
        "error_series_sha256": {"$ref": "#/$defs/sha256"},
        "failure_count": {"type": "integer", "minimum": 0},
        "failure_case_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "abstention_count": {"type": "integer", "minimum": 0},
        "maximum_error_mm": {"type": "number", "minimum": 0},
        "mean_error_mm": {"type": "number", "minimum": 0},
        "p95_error_mm": {"type": "number", "minimum": 0}
      }
    }
  }
}
