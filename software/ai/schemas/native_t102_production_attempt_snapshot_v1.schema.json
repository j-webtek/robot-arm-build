{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/native_t102_production_attempt_snapshot_v1.schema.json",
  "title": "RoCell native T102 production attempt snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recovery_disposition", "started_sha256", "terminal_sha256", "receipt_sha256", "automatic_retry_allowed", "replay_allowed", "snapshot_sha256"],
  "properties": {
    "schema": {"const": "rocell.native_t102_production_attempt_snapshot.v1"}, "recovery_disposition": {"enum": ["RETRY_FORBIDDEN_EXECUTION_UNCERTAIN", "TERMINAL_NO_REPLAY"]}, "started_sha256": {"$ref": "#/$defs/hash"}, "terminal_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}, "receipt_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}, "automatic_retry_allowed": {"const": false}, "replay_allowed": {"const": false}, "snapshot_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
