{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/native_t102_production_transport_receipt_v1.schema.json",
  "title": "RoCell native T102 production transport candidate receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "authority_sha256", "verification_sha256", "approval_record_sha256", "claim_sha256", "prepared_sha256", "frame_sha256", "wire_bytes_sha256", "endpoint_sha256", "correlation_id", "writer_instance_id", "controller_session_id", "requested_bytes", "confirmed_bytes", "open_attempts", "write_attempts", "capture_attempts", "close_attempts", "acknowledgment_sha256", "feedback_response_sha256", "maximum_joint_error_rad", "error_code", "automatic_retry_allowed", "follow_on_movement_authorized", "external_authority_verification_record_accepted", "physical_authority_claimed", "transport_implementation_qualified", "authentic_controller_receipt_claimed", "physical_movement_verified", "receipt_sha256"],
  "properties": {
    "schema": {"const": "rocell.native_t102_production_transport_receipt.v1"},
    "status": {"enum": ["CONTROLLER_EVIDENCE_CAPTURED_SETTLED_UNQUALIFIED", "ENDPOINT_IDENTITY_MISMATCH_NO_WRITE", "NOT_OPENED_AUTHORITY_CONSUMED_NO_RETRY", "WRITE_UNCERTAIN_NO_RETRY", "EVIDENCE_UNCERTAIN_NO_RETRY", "CLOSE_UNCERTAIN_NO_RETRY"]},
    "authority_sha256": {"$ref": "#/$defs/hash"},
    "verification_sha256": {"$ref": "#/$defs/hash"},
    "approval_record_sha256": {"$ref": "#/$defs/hash"},
    "claim_sha256": {"$ref": "#/$defs/hash"},
    "prepared_sha256": {"$ref": "#/$defs/hash"},
    "frame_sha256": {"$ref": "#/$defs/hash"},
    "wire_bytes_sha256": {"$ref": "#/$defs/hash"},
    "endpoint_sha256": {"$ref": "#/$defs/hash"},
    "correlation_id": {"$ref": "#/$defs/identifier"},
    "writer_instance_id": {"$ref": "#/$defs/identifier"},
    "controller_session_id": {"$ref": "#/$defs/identifier"},
    "requested_bytes": {"type": "integer", "minimum": 1},
    "confirmed_bytes": {"type": "integer", "minimum": 0},
    "open_attempts": {"type": "integer", "minimum": 0, "maximum": 1},
    "write_attempts": {"type": "integer", "minimum": 0, "maximum": 1},
    "capture_attempts": {"type": "integer", "minimum": 0, "maximum": 1},
    "close_attempts": {"type": "integer", "minimum": 0, "maximum": 1},
    "acknowledgment_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "feedback_response_sha256": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/hash"}},
    "maximum_joint_error_rad": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 100}]},
    "error_code": {"oneOf": [{"type": "null"}, {"enum": ["ENDPOINT_IDENTITY_MISMATCH", "OPEN_FAILURE", "ZERO_WRITE", "PARTIAL_WRITE", "INVALID_WRITE_COUNT", "WRITE_EXCEPTION", "CAPTURE_OR_EVIDENCE_FAILURE", "CLOSE_FAILURE"]}]},
    "automatic_retry_allowed": {"const": false},
    "follow_on_movement_authorized": {"const": false},
    "external_authority_verification_record_accepted": {"const": true},
    "physical_authority_claimed": {"const": false},
    "transport_implementation_qualified": {"const": false},
    "authentic_controller_receipt_claimed": {"const": false},
    "physical_movement_verified": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
  }
}
