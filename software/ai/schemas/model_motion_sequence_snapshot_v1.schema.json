{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/model_motion_sequence_snapshot_v1.schema.json",
  "title": "RoCell ordered model motion sequence snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "phase", "batch_sha256", "ingress_sha256", "action_count",
    "current_action_index", "completed_action_count", "dispatch_request_sha256",
    "used_dispatch_request_sha256",
    "used_observed_start_state_sha256", "planner_gate_sha256", "results",
    "blocker", "automatic_retry_allowed", "lookahead_planning_allowed",
    "controller_commands", "hardware_commands_generated", "hardware_access",
    "physical_authority", "sequence_snapshot_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.model_motion_sequence_snapshot.v1"},
    "phase": {"enum": ["WAITING_FOR_FRESH_STATE", "READY_FOR_SINGLE_ACTION_EXECUTOR", "WAITING_FOR_EXECUTION_RESULT", "COMPLETED", "BLOCKED", "OUTCOME_UNCERTAIN"]},
    "batch_sha256": {"$ref": "#/$defs/sha256"},
    "ingress_sha256": {"$ref": "#/$defs/sha256"},
    "action_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "current_action_index": {"type": ["integer", "null"], "minimum": 0},
    "completed_action_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "used_observed_start_state_sha256": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "planner_gate_sha256": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/sha256"}},
    "results": {"type": "array", "maxItems": 64, "items": {"type": "object"}},
    "dispatch_request_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "used_dispatch_request_sha256": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "blocker": {"type": ["string", "null"]},
    "automatic_retry_allowed": {"const": false},
    "lookahead_planning_allowed": {"const": false},
    "controller_commands": {"type": "array", "maxItems": 0},
    "hardware_commands_generated": {"const": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "sequence_snapshot_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
