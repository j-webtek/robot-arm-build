{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/model_motion_batch_v2.schema.json",
  "title": "Ordered model motion proposal batch v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "batch_id", "request_id", "intent_plan_sha256",
    "device", "capability", "geometry", "evidence", "uncertainty", "proposals",
    "controller_commands", "hardware_access", "physical_authority",
    "batch_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.model_motion_batch.v2"},
    "batch_id": {"$ref": "#/$defs/identifier"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "intent_plan_sha256": {"$ref": "#/$defs/sha256"},
    "device": {"enum": ["keyboard", "phone"]},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_sha256"],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinate_profile", "coordinate_units", "board_frame_definition_sha256", "placement_observation_sha256", "target_catalog_sha256"],
      "properties": {
        "coordinate_profile": {"const": "board_mm_xy_plane_v2"},
        "coordinate_units": {"const": "mm"},
        "board_frame_definition_sha256": {"$ref": "#/$defs/sha256"},
        "placement_observation_sha256": {"$ref": "#/$defs/sha256"},
        "target_catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id", "frame_id", "image_sha256", "camera_identity_sha256",
        "capture_clock_domain_id", "model_id", "model_sha256",
        "scene_observation_sha256", "precision_observation_sha256",
        "fusion_decision_sha256", "scene_lease_id", "scene_lease_issuer_id",
        "scene_lease_sha256", "captured_at_epoch_ms", "evaluated_at_epoch_ms",
        "expires_at_epoch_ms"
      ],
      "properties": {
        "capture_id": {"$ref": "#/$defs/identifier"},
        "model_id": {"$ref": "#/$defs/identifier"},
        "frame_id": {"$ref": "#/$defs/identifier"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "camera_identity_sha256": {"$ref": "#/$defs/sha256"},
        "capture_clock_domain_id": {"$ref": "#/$defs/identifier"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "scene_observation_sha256": {"$ref": "#/$defs/sha256"},
        "precision_observation_sha256": {"$ref": "#/$defs/sha256"},
        "fusion_decision_sha256": {"$ref": "#/$defs/sha256"},
        "scene_lease_id": {"$ref": "#/$defs/identifier"},
        "scene_lease_issuer_id": {"$ref": "#/$defs/identifier"},
        "scene_lease_sha256": {"$ref": "#/$defs/sha256"},
        "captured_at_epoch_ms": {"type": "integer", "minimum": 1},
        "evaluated_at_epoch_ms": {"type": "integer", "minimum": 1},
        "expires_at_epoch_ms": {"type": "integer", "minimum": 1}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bound_type", "error_bound_mm", "coverage_probability",
        "qualification_sha256", "evidence_method_sha256", "domain_id", "covered_target_ids"
      ],
      "properties": {
        "bound_type": {"const": "planar_l2_disk"},
        "error_bound_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "coverage_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "qualification_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_method_sha256": {"$ref": "#/$defs/sha256"},
        "domain_id": {"$ref": "#/$defs/identifier"},
        "covered_target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "model_motion_proposal_v2.schema.json"}
    },
    "controller_commands": {"type": "array", "maxItems": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "batch_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
