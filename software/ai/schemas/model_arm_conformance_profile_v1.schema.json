{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/model_arm_conformance_profile_v1.schema.json",
  "title": "Model-to-arm conformance profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "profile_id", "reviewed_sources", "wire_boundary",
    "model_must_supply", "arm_must_own", "prohibited_model_fields",
    "conformance_cases", "current_result"
  ],
  "properties": {
    "schema": {"const": "rocell.model_arm_conformance_profile.v1"},
    "profile_id": {"$ref": "#/$defs/identifier"},
    "reviewed_sources": {
      "type": "object", "additionalProperties": false,
      "required": ["arm_main_commit", "ai_branch", "ai_branch_commit", "ai_latest_study", "ai_selection_passed", "ai_qualification_installed"],
      "properties": {
        "arm_main_commit": {"$ref": "#/$defs/sha40"},
        "ai_branch": {"type": "string", "minLength": 1},
        "ai_branch_commit": {"$ref": "#/$defs/sha40"},
        "ai_latest_study": {"$ref": "#/$defs/identifier"},
        "ai_selection_passed": {"const": false},
        "ai_qualification_installed": {"const": false}
      }
    },
    "wire_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["batch_schema", "proposal_schema", "coordinate_profile", "coordinate_units", "maximum_actions", "supported_device", "supported_action", "supported_interaction"],
      "properties": {
        "batch_schema": {"const": "rocell.model_motion_batch.v2"},
        "proposal_schema": {"const": "rocell.model_motion_proposal.v2"},
        "coordinate_profile": {"const": "board_mm_xy_plane_v2"},
        "coordinate_units": {"const": "mm"},
        "maximum_actions": {"const": 64},
        "supported_device": {"const": "keyboard"},
        "supported_action": {"const": "press_key"},
        "supported_interaction": {"const": "contact"}
      }
    },
    "model_must_supply": {"$ref": "#/$defs/uniqueIdentifiers"},
    "arm_must_own": {"$ref": "#/$defs/uniqueIdentifiers"},
    "prohibited_model_fields": {"$ref": "#/$defs/uniqueIdentifiers"},
    "conformance_cases": {
      "type": "array", "minItems": 6, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "expected_disposition", "expected_targets"],
        "properties": {
          "case_id": {"$ref": "#/$defs/identifier"},
          "expected_disposition": {"enum": ["accepted_for_fresh_sequential_planner_gates", "producer_abstains", "unsupported_by_initial_profile", "consumer_rejects", "decoder_rejects"]},
          "expected_targets": {"type": "array", "items": {"$ref": "#/$defs/identifier"}}
        }
      }
    },
    "current_result": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_alignment", "simulation_result", "planner_result", "operational_result", "controller_commands", "hardware_access", "physical_authority"],
      "properties": {
        "contract_alignment": {"const": "ALIGNED"},
        "simulation_result": {"const": "AI_BYTES_REACH_ARM_GATE"},
        "planner_result": {"const": "BLOCKED_CALIBRATION_MISSING_OR_STALE"},
        "operational_result": {"const": "BLOCKED_PHYSICAL_EVIDENCE_AND_QUALIFIED_PERCEPTION_MISSING"},
        "controller_commands": {"type": "array", "maxItems": 0},
        "hardware_access": {"const": false},
        "physical_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "uniqueIdentifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
  }
}
