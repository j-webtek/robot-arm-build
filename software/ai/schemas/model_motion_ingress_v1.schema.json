{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/model_motion_ingress_v1.schema.json",
  "title": "RoCell model motion ingress report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "batch_sha256", "intent_plan_sha256", "request_id",
    "source_bindings", "ordered_target_ids", "ordered_candidate_sha256",
    "candidates", "next_required_stage", "controller_commands",
    "hardware_commands_generated", "hardware_access", "physical_authority",
    "ingress_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.model_motion_ingress.v1"},
    "status": {"const": "ACCEPTED_OFFLINE_FOR_ORDERED_PLANNER_GATES"},
    "batch_sha256": {"$ref": "#/$defs/sha256"},
    "intent_plan_sha256": {"$ref": "#/$defs/sha256"},
    "request_id": {"type": "string", "minLength": 1},
    "source_bindings": {"type": "object"},
    "ordered_target_ids": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
    "ordered_candidate_sha256": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/sha256"}},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object"}},
    "next_required_stage": {"const": "EVALUATE_EACH_ACTION_WITH_FRESH_STATE_AND_CALIBRATED_PLANNER"},
    "controller_commands": {"type": "array", "maxItems": 0},
    "hardware_commands_generated": {"const": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "ingress_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
