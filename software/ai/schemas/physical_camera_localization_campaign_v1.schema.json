{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/physical_camera_localization_campaign_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "campaign_id", "source_commit", "domain_id",
    "camera_support_optics_intake_sha256", "configuration_epoch_sha256",
    "camera_profile_sha256", "camera_identity_sha256", "camera_mode_controls_sha256",
    "camera_intrinsics_sha256", "camera_to_board_calibration_sha256",
    "keyboard_target_map_sha256", "model_artifact_manifest_sha256",
    "ground_truth_method", "requirements", "calibration_captures",
    "evaluation_captures", "camera_open_authorized", "controller_start_authorized",
    "execution_authorized", "hardware_writes", "physical_movements",
    "campaign_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.physical_camera_localization_campaign.v1"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "domain_id": {"$ref": "#/$defs/id"},
    "camera_support_optics_intake_sha256": {"$ref": "#/$defs/sha"},
    "configuration_epoch_sha256": {"$ref": "#/$defs/sha"},
    "camera_profile_sha256": {"$ref": "#/$defs/sha"},
    "camera_identity_sha256": {"$ref": "#/$defs/sha"},
    "camera_mode_controls_sha256": {"$ref": "#/$defs/sha"},
    "camera_intrinsics_sha256": {"$ref": "#/$defs/sha"},
    "camera_to_board_calibration_sha256": {"$ref": "#/$defs/sha"},
    "keyboard_target_map_sha256": {"$ref": "#/$defs/sha"},
    "model_artifact_manifest_sha256": {"$ref": "#/$defs/sha"},
    "ground_truth_method": {"const": "INDEPENDENT_SURVEYED_FIDUCIAL_GEOMETRY"},
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": [
        "minimum_calibration_captures", "minimum_evaluation_captures",
        "minimum_evaluation_captures_per_condition", "required_conditions",
        "split_sessions_disjoint", "declared_coverage_probability",
        "confidence_level", "safe_region_rule"
      ],
      "properties": {
        "minimum_calibration_captures": {"const": 300},
        "minimum_evaluation_captures": {"const": 300},
        "minimum_evaluation_captures_per_condition": {"const": 20},
        "required_conditions": {
          "type": "array", "minItems": 11, "maxItems": 11,
          "uniqueItems": true,
          "items": {"enum": [
            "nominal", "low_light", "high_light", "glare", "blur",
            "arm_occlusion", "tool_occlusion", "cable_occlusion",
            "placement_translation", "placement_yaw", "device_absent"
          ]}
        },
        "split_sessions_disjoint": {"const": true},
        "declared_coverage_probability": {"const": 0.99},
        "confidence_level": {"const": 0.95},
        "safe_region_rule": {"const": "COMPOSED_ERROR_BOUND_MUST_FIT_PER_TARGET_SAFE_REGION"}
      }
    },
    "calibration_captures": {
      "type": "array", "minItems": 300, "items": {"$ref": "#/$defs/capture"}
    },
    "evaluation_captures": {
      "type": "array", "minItems": 300, "items": {"$ref": "#/$defs/capture"}
    },
    "camera_open_authorized": {"const": false},
    "controller_start_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "campaign_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,191}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_path", "size_bytes", "sha256"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": [
        "capture_id", "session_id", "captured_at_utc", "conditions",
        "camera_identity_sha256", "camera_mode_controls_sha256",
        "configuration_epoch_sha256", "image", "ground_truth"
      ],
      "properties": {
        "capture_id": {"$ref": "#/$defs/id"},
        "session_id": {"$ref": "#/$defs/id"},
        "captured_at_utc": {"type": "string", "format": "date-time"},
        "conditions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": [
            "nominal", "low_light", "high_light", "glare", "blur",
            "arm_occlusion", "tool_occlusion", "cable_occlusion",
            "placement_translation", "placement_yaw", "device_absent"
          ]}
        },
        "camera_identity_sha256": {"$ref": "#/$defs/sha"},
        "camera_mode_controls_sha256": {"$ref": "#/$defs/sha"},
        "configuration_epoch_sha256": {"$ref": "#/$defs/sha"},
        "image": {"$ref": "#/$defs/file"},
        "ground_truth": {"$ref": "#/$defs/file"}
      }
    }
  }
}
