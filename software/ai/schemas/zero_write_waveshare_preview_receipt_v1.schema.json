{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/zero_write_waveshare_preview_receipt_v1.schema.json",
  "title": "RoCell zero-write Waveshare preview receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "envelope_v2_sha256", "measured_envelope_sha256",
    "permit_id", "encoding_profile_sha256", "correlation_id",
    "controller_session_id", "created_monotonic_ns", "command_count",
    "commands", "transport_opened", "transport_write_count",
    "submitted_bytes", "acknowledgements", "feedback_samples",
    "timeout_events", "automatic_retry", "hardware_access",
    "physical_authority", "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.zero_write_waveshare_preview_receipt.v1"},
    "status": {"const": "ZERO_WRITE_ENCODING_ONLY"},
    "envelope_v2_sha256": {"$ref": "#/$defs/sha256"},
    "measured_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "permit_id": {"$ref": "#/$defs/sha256"},
    "encoding_profile_sha256": {"$ref": "#/$defs/sha256"},
    "correlation_id": {"$ref": "#/$defs/identifier"},
    "controller_session_id": {"$ref": "#/$defs/identifier"},
    "created_monotonic_ns": {"type": "integer", "minimum": 1},
    "command_count": {"type": "integer", "minimum": 1, "maximum": 511},
    "commands": {"type": "array", "minItems": 1, "maxItems": 511, "items": {"$ref": "#/$defs/command"}},
    "transport_opened": {"const": false},
    "transport_write_count": {"const": 0},
    "submitted_bytes": {"type": "array", "maxItems": 0},
    "acknowledgements": {"type": "array", "maxItems": 0},
    "feedback_samples": {"type": "array", "maxItems": 0},
    "timeout_events": {"type": "array", "maxItems": 0},
    "automatic_retry": {"const": false},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["T", "base", "shoulder", "elbow", "wrist", "roll", "hand", "spd", "acc"],
      "properties": {
        "T": {"const": 102},
        "base": {"type": "number"}, "shoulder": {"type": "number"},
        "elbow": {"type": "number"}, "wrist": {"type": "number"},
        "roll": {"type": "number"}, "hand": {"type": "number"},
        "spd": {"type": "integer", "minimum": 1, "maximum": 65535},
        "acc": {"type": "integer", "minimum": 1, "maximum": 255}
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["waypoint_sequence", "time_from_start_ns", "scheduled_dispatch_monotonic_ns", "message", "payload_utf8", "wire_bytes_sha256"],
      "properties": {
        "waypoint_sequence": {"type": "integer", "minimum": 1, "maximum": 511},
        "time_from_start_ns": {"type": "integer", "minimum": 1},
        "scheduled_dispatch_monotonic_ns": {"type": "integer", "minimum": 1},
        "message": {"$ref": "#/$defs/message"},
        "payload_utf8": {"type": "string", "minLength": 2},
        "wire_bytes_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
