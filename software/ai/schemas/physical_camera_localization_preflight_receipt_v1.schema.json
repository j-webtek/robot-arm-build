{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/physical_camera_localization_preflight_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "campaign_id", "campaign_sha256",
    "calibration_capture_count", "evaluation_capture_count",
    "calibration_session_count", "evaluation_session_count",
    "evaluation_condition_counts", "verified_retained_file_count",
    "camera_opened", "model_loaded", "controller_started",
    "hardware_writes", "physical_movements", "qualification_installed",
    "limitations", "receipt_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.physical_camera_localization_campaign_preflight.v1"},
    "status": {"const": "READY_FOR_OFFLINE_EVALUATION"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,191}$"},
    "campaign_sha256": {"$ref": "#/$defs/sha"},
    "calibration_capture_count": {"type": "integer", "minimum": 300},
    "evaluation_capture_count": {"type": "integer", "minimum": 300},
    "calibration_session_count": {"type": "integer", "minimum": 1},
    "evaluation_session_count": {"type": "integer", "minimum": 1},
    "evaluation_condition_counts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "nominal", "low_light", "high_light", "glare", "blur",
        "arm_occlusion", "tool_occlusion", "cable_occlusion",
        "placement_translation", "placement_yaw", "device_absent"
      ],
      "properties": {
        "nominal": {"type": "integer", "minimum": 20},
        "low_light": {"type": "integer", "minimum": 20},
        "high_light": {"type": "integer", "minimum": 20},
        "glare": {"type": "integer", "minimum": 20},
        "blur": {"type": "integer", "minimum": 20},
        "arm_occlusion": {"type": "integer", "minimum": 20},
        "tool_occlusion": {"type": "integer", "minimum": 20},
        "cable_occlusion": {"type": "integer", "minimum": 20},
        "placement_translation": {"type": "integer", "minimum": 20},
        "placement_yaw": {"type": "integer", "minimum": 20},
        "device_absent": {"type": "integer", "minimum": 20}
      }
    },
    "verified_retained_file_count": {"type": "integer", "minimum": 1200},
    "camera_opened": {"const": false},
    "model_loaded": {"const": false},
    "controller_started": {"const": false},
    "hardware_writes": {"const": 0},
    "physical_movements": {"const": 0},
    "qualification_installed": {"const": false},
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "receipt_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
