{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/model_motion_proposal_v2.schema.json",
  "title": "RoCell model coordinate proposal v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "proposal_id", "action_index", "device", "target_id", "coordinate_frame",
    "target_mm", "interaction", "observation_confidence"
  ],
  "properties": {
    "schema": {"const": "rocell.model_motion_proposal.v2"},
    "proposal_id": {"$ref": "#/$defs/identifier"},
    "action_index": {"type": "integer", "minimum": 0, "maximum": 63},
    "device": {"enum": ["keyboard", "phone"]},
    "target_id": {"$ref": "#/$defs/identifier"},
    "coordinate_frame": {"const": "board"},
    "target_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "z": {"type": "number"}
      }
    },
    "interaction": {"enum": ["HOVER", "CONTACT"]},
    "observation_confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
