{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/bounded_segment_collision_qualification_v1.schema.json",
  "title": "RoCell bounded segment collision qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "source_trajectory_screening_sha256",
    "expanded_trajectory_screening_sha256", "installed_collision_profile_sha256",
    "sampling_policy", "sample_count", "maximum_observed_joint_gap_rad",
    "sample_plan", "fk_collision_qualification",
    "all_bounded_samples_collision_free", "continuous_collision_proven",
    "blockers", "next_required_stage", "controller_commands",
    "hardware_commands_generated", "hardware_access", "physical_authority",
    "bounded_segment_qualification_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.bounded_segment_collision_qualification.v1"},
    "status": {"enum": [
      "BOUNDED_SEGMENT_SAMPLES_CLEAR_CONSERVATIVE_SWEEP_REQUIRED",
      "BLOCKED_COLLISION_DETECTED_AT_BOUNDED_SAMPLE",
      "BLOCKED_INCOMPLETE_BOUNDED_SEGMENT_EVIDENCE"
    ]},
    "source_trajectory_screening_sha256": {"$ref": "#/$defs/hash"},
    "expanded_trajectory_screening_sha256": {"$ref": "#/$defs/hash"},
    "installed_collision_profile_sha256": {"$ref": "#/$defs/hash"},
    "sampling_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_joint_step_rad", "maximum_samples", "sampling_policy_sha256"],
      "properties": {
        "maximum_joint_step_rad": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.25},
        "maximum_samples": {"type": "integer", "minimum": 2, "maximum": 256},
        "sampling_policy_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "sample_count": {"type": "integer", "minimum": 2, "maximum": 256},
    "maximum_observed_joint_gap_rad": {"type": "number", "minimum": 0, "maximum": 0.25},
    "sample_plan": {
      "type": "array", "minItems": 2, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "sample_sequence", "sample_id", "source_segment_index",
          "subdivision_index", "subdivision_count", "interpolation_ratio",
          "joint_positions_rad"
        ],
        "properties": {
          "sample_sequence": {"type": "integer", "minimum": 0},
          "sample_id": {"type": "string", "pattern": "^segment-[0-9]{4}-sample-[0-9]{4}$"},
          "source_segment_index": {"type": "integer", "minimum": 0},
          "subdivision_index": {"type": "integer", "minimum": 0},
          "subdivision_count": {"type": "integer", "minimum": 1},
          "interpolation_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "joint_positions_rad": {
            "type": "object", "additionalProperties": false,
            "required": [
              "base_link_to_link1", "link1_to_link2", "link2_to_link3",
              "link3_to_link4", "link4_to_link5"
            ],
            "properties": {
              "base_link_to_link1": {"type": "number"},
              "link1_to_link2": {"type": "number"},
              "link2_to_link3": {"type": "number"},
              "link3_to_link4": {"type": "number"},
              "link4_to_link5": {"type": "number"}
            }
          }
        }
      }
    },
    "fk_collision_qualification": {"type": "object"},
    "all_bounded_samples_collision_free": {"type": "boolean"},
    "continuous_collision_proven": {"const": false},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_required_stage": {"type": "string", "minLength": 1},
    "controller_commands": {"type": "array", "maxItems": 0},
    "hardware_commands_generated": {"const": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "bounded_segment_qualification_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
