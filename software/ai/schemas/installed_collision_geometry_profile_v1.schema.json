{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/installed_collision_geometry_profile_v1.schema.json",
  "title": "Installed collision geometry profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "manifest_id", "manifest_sha256", "active_build_id", "build_snapshot_sha256", "robot_model_sha256", "base_contract_sha256", "source_bindings", "bodies", "pair_exclusions", "clearance_policy", "content_sha256"],
  "properties": {
    "schema": {"const": "rocell.installed_collision_geometry_profile.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "active_build_id": {"type": "string", "minLength": 1},
    "build_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "robot_model_sha256": {"$ref": "#/$defs/sha256"},
    "base_contract_sha256": {"$ref": "#/$defs/sha256"},
    "source_bindings": {"type": "object", "minProperties": 1, "propertyNames": {"minLength": 1}, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "bodies": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/body"}},
    "pair_exclusions": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/exclusion"}},
    "clearance_policy": {"$ref": "#/$defs/clearance"},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "primitive": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "center_mm", "radius_mm"],
          "properties": {"kind": {"const": "sphere"}, "center_mm": {"$ref": "#/$defs/vec3"}, "radius_mm": {"type": "number", "exclusiveMinimum": 0}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "start_mm", "end_mm", "radius_mm"],
          "properties": {"kind": {"const": "capsule"}, "start_mm": {"$ref": "#/$defs/vec3"}, "end_mm": {"$ref": "#/$defs/vec3"}, "radius_mm": {"type": "number", "exclusiveMinimum": 0}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "center_mm", "half_extents_mm", "rotation_row_major"],
          "properties": {
            "kind": {"const": "oriented_box"}, "center_mm": {"$ref": "#/$defs/vec3"},
            "half_extents_mm": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
            "rotation_row_major": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "number"}}
          }
        }
      ]
    },
    "body": {
      "type": "object", "additionalProperties": false,
      "required": ["body_id", "parent_frame", "role", "binding_mode", "evidence_state", "source_reference", "primitives"],
      "properties": {
        "body_id": {"type": "string", "minLength": 1}, "parent_frame": {"type": "string", "minLength": 1},
        "role": {"enum": ["ROBOT_LINK", "BASE_CLAMP", "ATTACHMENT", "CAMERA", "CONNECTOR", "CABLE", "TOOL", "STATIC_ENVIRONMENT"]},
        "binding_mode": {"enum": ["RIGID_FRAME", "STATIC_ROOT", "CONFIGURATION_SAMPLED"]},
        "evidence_state": {"const": "ACCEPTED_MEASURED"}, "source_reference": {"type": "string", "minLength": 1},
        "primitives": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/primitive"}}
      }
    },
    "exclusion": {
      "type": "object", "additionalProperties": false,
      "required": ["body_pair", "scope", "evidence_state", "rationale", "source_reference"],
      "properties": {
        "body_pair": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}},
        "scope": {"const": "ENGINEERING_GLOBAL"}, "evidence_state": {"const": "ACCEPTED_ENGINEERING"},
        "rationale": {"type": "string", "minLength": 1}, "source_reference": {"type": "string", "minLength": 1}
      }
    },
    "clearance": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_separation_mm", "geometry_uncertainty_mm_per_body", "pose_uncertainty_mm_per_body", "evidence_state", "source_reference"],
      "properties": {
        "minimum_separation_mm": {"type": "number", "minimum": 0},
        "geometry_uncertainty_mm_per_body": {"type": "number", "minimum": 0},
        "pose_uncertainty_mm_per_body": {"type": "number", "minimum": 0},
        "evidence_state": {"const": "ACCEPTED_MEASURED"}, "source_reference": {"type": "string", "minLength": 1}
      }
    }
  }
}
