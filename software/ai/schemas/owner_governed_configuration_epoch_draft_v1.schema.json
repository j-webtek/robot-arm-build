{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/owner_governed_configuration_epoch_draft_v1.schema.json",
  "title": "RoCell owner-governed configuration epoch draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "epoch_id", "predecessor_configuration_epoch_sha256",
    "owner_acceptance_sha256", "r97_review_packet_sha256",
    "candidate_app_sha256", "protocol_source_sha256",
    "joint_mapping_source_sha256", "components", "epoch_scope",
    "human_review_required", "human_review_claimed",
    "external_independence_claimed", "owner_governance_override",
    "hardware_access", "installation_authorized",
    "controller_start_authorized", "transport_authorized",
    "execution_authorized", "physical_authority", "draft_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.owner_governed_configuration_epoch_draft.v1"},
    "epoch_id": {"$ref": "#/$defs/identifier"},
    "predecessor_configuration_epoch_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "owner_acceptance_sha256": {"$ref": "#/$defs/sha256"},
    "r97_review_packet_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_app_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_source_sha256": {"$ref": "#/$defs/sha256"},
    "joint_mapping_source_sha256": {"$ref": "#/$defs/sha256"},
    "components": {
      "type": "array", "minItems": 0, "maxItems": 8,
      "items": {"$ref": "#/$defs/component"}
    },
    "epoch_scope": {"const": "OWNER_GOVERNED_RELEASE_PLUS_MEASURED_WORKCELL"},
    "human_review_required": {"const": false},
    "human_review_claimed": {"const": false},
    "external_independence_claimed": {"const": false},
    "owner_governance_override": {"const": true},
    "hardware_access": {"const": false},
    "installation_authorized": {"const": false},
    "controller_start_authorized": {"const": false},
    "transport_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "physical_authority": {"const": false},
    "draft_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "evidence_sha256"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/identifier"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": [
        "component_id", "installation_state", "evidence_bundle_sha256",
        "binding_evidence", "owner_ai_review_sha256",
        "measured_monotonic_ns", "valid_until_monotonic_ns",
        "evidence_origin", "review_disposition"
      ],
      "properties": {
        "component_id": {"enum": [
          "software_build", "camera_support_optics", "board_tags_bench",
          "arm_controller_tool", "power_system", "keyboard_station",
          "phone_station", "empty_cell_safety"
        ]},
        "installation_state": {
          "enum": ["INSTALLED", "CONFIRMED_NOT_INSTALLED"]
        },
        "evidence_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "binding_evidence": {
          "type": "array", "minItems": 0, "maxItems": 5,
          "items": {"$ref": "#/$defs/binding"}
        },
        "owner_ai_review_sha256": {"$ref": "#/$defs/sha256"},
        "measured_monotonic_ns": {"type": "integer", "minimum": 1},
        "valid_until_monotonic_ns": {"type": "integer", "minimum": 1},
        "evidence_origin": {
          "enum": ["PHYSICAL_RETAINED_ORIGINALS", "SYNTHETIC_TEST_ONLY"]
        },
        "review_disposition": {
          "enum": ["OWNER_AI_ACCEPTED", "UNREVIEWED", "REJECTED"]
        }
      }
    }
  }
}
