{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j-webtek/robot-arm-build/software/ai/schemas/model_motion_simulation_v0.schema.json",
  "title": "RoCell offline model motion simulation report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "proposal_sha256", "candidate_sha256", "assurance_bundle_sha256",
    "static_context_bundle_sha256", "static_target_catalog_sha256",
    "simulation_target_overlay", "plan_hash", "geometry_report_sha256",
    "geometry_all_checks_pass", "sampled_ik_all_converged", "dense_route_status",
    "dense_route_all_waypoints_accepted", "evaluated_waypoint_count", "first_failure",
    "simulation_status", "physical_calibration_verified", "continuous_path_proven",
    "full_arm_collision_checked", "physical_execution_authorized", "hardware_commands",
    "hardware_writes", "physical_input_events_observed", "limitations", "simulation_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.ai_model_motion_simulation.v0"},
    "proposal_sha256": {"$ref": "#/$defs/hash"},
    "candidate_sha256": {"$ref": "#/$defs/hash"},
    "assurance_bundle_sha256": {"$ref": "#/$defs/hash"},
    "static_context_bundle_sha256": {"$ref": "#/$defs/hash"},
    "static_target_catalog_sha256": {"$ref": "#/$defs/hash"},
    "simulation_target_overlay": {
      "type": "object",
      "required": ["schema", "base_static_target_catalog_sha256", "model_candidate_sha256", "device", "target_id", "center_board_mm", "simulation_only", "overlay_sha256"],
      "properties": {
        "schema": {"const": "rocell.model_motion_target_overlay.v0"},
        "base_static_target_catalog_sha256": {"$ref": "#/$defs/hash"},
        "model_candidate_sha256": {"$ref": "#/$defs/hash"},
        "device": {"const": "keyboard"},
        "target_id": {"type": "string", "minLength": 1},
        "center_board_mm": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
        "simulation_only": {"const": true},
        "overlay_sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "plan_hash": {"$ref": "#/$defs/hash"},
    "geometry_report_sha256": {"$ref": "#/$defs/hash"},
    "geometry_all_checks_pass": {"type": "boolean"},
    "sampled_ik_all_converged": {"type": "boolean"},
    "dense_route_status": {"type": "string", "minLength": 1},
    "dense_route_all_waypoints_accepted": {"type": "boolean"},
    "evaluated_waypoint_count": {"type": ["integer", "null"], "minimum": 0},
    "first_failure": {"type": ["object", "null"]},
    "simulation_status": {"enum": ["SAMPLES_PASS_NOT_EXECUTABLE", "SIMULATION_BLOCKED"]},
    "physical_calibration_verified": {"const": false},
    "continuous_path_proven": {"const": false},
    "full_arm_collision_checked": {"const": false},
    "physical_execution_authorized": {"const": false},
    "hardware_commands": {"const": []},
    "hardware_writes": {"const": 0},
    "physical_input_events_observed": {"const": 0},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "simulation_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
