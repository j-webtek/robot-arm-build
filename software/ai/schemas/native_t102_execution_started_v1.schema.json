{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/native_t102_execution_started_v1.schema.json",
  "title": "RoCell native T102 durable execution-started marker v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "prepared_sha256", "claim_sha256",
    "authority_sha256", "approval_record_sha256", "frame_sha256",
    "wire_bytes_sha256", "pinned_endpoint_sha256", "correlation_id",
    "writer_instance_id", "controller_session_id", "started_monotonic_ns",
    "transport_open_count", "physical_command_writes",
    "automatic_retry_allowed", "hardware_access", "physical_authority",
    "recovery_disposition", "started_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.native_t102_execution_started.v1"},
    "status": {"const": "EXECUTION_STARTED_BEFORE_TRANSPORT_OPEN"},
    "prepared_sha256": {"$ref": "#/$defs/hash"},
    "claim_sha256": {"$ref": "#/$defs/hash"},
    "authority_sha256": {"$ref": "#/$defs/hash"},
    "approval_record_sha256": {"$ref": "#/$defs/hash"},
    "frame_sha256": {"$ref": "#/$defs/hash"},
    "wire_bytes_sha256": {"$ref": "#/$defs/hash"},
    "pinned_endpoint_sha256": {"$ref": "#/$defs/hash"},
    "correlation_id": {"$ref": "#/$defs/identifier"},
    "writer_instance_id": {"$ref": "#/$defs/identifier"},
    "controller_session_id": {"$ref": "#/$defs/identifier"},
    "started_monotonic_ns": {"type": "integer", "minimum": 1},
    "transport_open_count": {"const": 0},
    "physical_command_writes": {"const": 0},
    "automatic_retry_allowed": {"const": false},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "recovery_disposition": {"const": "RETRY_FORBIDDEN_EXECUTION_UNCERTAIN"},
    "started_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
