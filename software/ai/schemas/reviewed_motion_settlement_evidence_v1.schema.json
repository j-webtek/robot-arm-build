{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/reviewed_motion_settlement_evidence_v1.schema.json",
  "title": "RoCell reviewed motion settlement evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "dispatch_receipt_sha256", "goal_sha256",
    "assessed_monotonic_ns", "accepted_sample_count", "rejected_sample_codes",
    "consecutive_settled_samples", "required_consecutive_samples",
    "position_tolerance_mm", "angle_tolerance_rad", "max_position_error_mm",
    "max_angle_error_rad", "feedback_message_sha256", "controller_receipt_claimed",
    "independent_outcome_verified", "settlement_sha256"],
  "properties": {
    "schema": {"const": "rocell.reviewed_motion_settlement_evidence.v1"},
    "status": {"enum": ["OBSERVED_SETTLED_ARRIVAL", "ARRIVAL_UNVERIFIED"]},
    "dispatch_receipt_sha256": {"$ref": "#/$defs/hash"},
    "goal_sha256": {"$ref": "#/$defs/hash"},
    "assessed_monotonic_ns": {"type": "integer", "minimum": 1},
    "accepted_sample_count": {"type": "integer", "minimum": 0, "maximum": 1024},
    "rejected_sample_codes": {"type": "array", "maxItems": 1024,
      "items": {"enum": ["MALFORMED_SAMPLE", "NON_MONOTONIC_OR_PRE_DISPATCH",
        "STALE_OR_FUTURE_FEEDBACK", "INVALID_T1051", "INCOMPLETE_POSE"]}},
    "consecutive_settled_samples": {"type": "integer", "minimum": 0, "maximum": 1024},
    "required_consecutive_samples": {"type": "integer", "minimum": 2, "maximum": 16},
    "position_tolerance_mm": {"type": "number", "minimum": 0},
    "angle_tolerance_rad": {"type": "number", "minimum": 0},
    "max_position_error_mm": {"type": "number", "minimum": 0},
    "max_angle_error_rad": {"type": "number", "minimum": 0},
    "feedback_message_sha256": {"type": "array", "maxItems": 1024,
      "items": {"$ref": "#/$defs/hash"}},
    "controller_receipt_claimed": {"const": false},
    "independent_outcome_verified": {"const": false},
    "settlement_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
