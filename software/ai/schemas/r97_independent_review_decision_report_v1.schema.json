{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/r97_independent_review_decision_report_v1.schema.json",
  "title": "RoCell r97 independent-review decision assessment v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "decision_sha256", "blockers",
    "ready_for_epoch_intake", "installation_authorized", "controller_start_authorized",
    "execution_authorized", "hardware_access", "physical_authority", "report_sha256"],
  "properties": {
    "schema": {"const": "rocell.r97_independent_review_decision_report.v1"},
    "status": {"enum": ["BLOCKED", "INDEPENDENT_REVIEW_ACCEPTED"]},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"enum": [
      "DECISION_NOT_APPROVED", "PACKET_IDENTITY_MISMATCH",
      "MANIFEST_IDENTITY_MISMATCH", "APP_IDENTITY_MISMATCH",
      "INDEPENDENCE_NOT_ASSERTED", "IMPLEMENTATION_AUTHOR_CONFLICT",
      "CHECKLIST_INCOMPLETE", "APPROVAL_HAS_OPEN_FINDINGS"]}},
    "ready_for_epoch_intake": {"type": "boolean"},
    "installation_authorized": {"const": false},
    "controller_start_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
