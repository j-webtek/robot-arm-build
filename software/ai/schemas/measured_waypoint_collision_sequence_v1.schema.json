{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/measured_waypoint_collision_sequence_v1.schema.json",
  "title": "RoCell measured waypoint collision sequence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "trajectory_screening_sha256",
    "installed_collision_profile_sha256", "collision_contract_sha256",
    "collision_policy_sha256", "sample_count",
    "configuration_sampled_body_ids", "pose_reports",
    "full_body_waypoint_screen_executed",
    "all_waypoints_collision_free_at_supplied_samples",
    "continuous_collision_proven", "blockers", "next_required_stage",
    "controller_commands", "hardware_commands_generated", "hardware_access",
    "physical_authority", "waypoint_collision_sequence_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.measured_waypoint_collision_sequence.v1"},
    "status": {"enum": [
      "DISCRETE_WAYPOINTS_CLEAR_CONTINUOUS_PROOF_REQUIRED",
      "BLOCKED_COLLISION_DETECTED",
      "BLOCKED_INCOMPLETE_WAYPOINT_COLLISION_EVIDENCE"
    ]},
    "trajectory_screening_sha256": {"$ref": "#/$defs/hash"},
    "installed_collision_profile_sha256": {"$ref": "#/$defs/hash"},
    "collision_contract_sha256": {"$ref": "#/$defs/hash"},
    "collision_policy_sha256": {"$ref": "#/$defs/hash"},
    "sample_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "configuration_sampled_body_ids": {
      "type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}
    },
    "pose_reports": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sample", "collision_report_sha256", "status",
          "collision_free_diagnostic", "collisions", "pose_blockers"],
        "properties": {
          "sample": {
            "type": "object", "additionalProperties": false,
            "required": ["waypoint_sequence", "source_waypoint_sha256",
              "source_joint_result_sha256", "pose_sha256", "pose"],
            "properties": {
              "waypoint_sequence": {"type": "integer", "minimum": 0},
              "source_waypoint_sha256": {"$ref": "#/$defs/hash"},
              "source_joint_result_sha256": {"$ref": "#/$defs/hash"},
              "pose_sha256": {"$ref": "#/$defs/hash"},
              "pose": {"type": "object"}
            }
          },
          "collision_report_sha256": {"$ref": "#/$defs/hash"},
          "status": {"type": "string", "minLength": 1},
          "collision_free_diagnostic": {"type": "boolean"},
          "collisions": {"type": "array", "items": {"type": "object"}},
          "pose_blockers": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "full_body_waypoint_screen_executed": {"const": true},
    "all_waypoints_collision_free_at_supplied_samples": {"type": "boolean"},
    "continuous_collision_proven": {"const": false},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "next_required_stage": {"enum": [
      "SUPPLY_CONSERVATIVE_INTER_WAYPOINT_SWEEP_PROOF",
      "CORRECT_ROUTE_OR_INSTALLED_GEOMETRY",
      "SUPPLY_COMPLETE_RIGID_TRANSFORMS_AND_DEFORMABLE_GEOMETRY"
    ]},
    "controller_commands": {"type": "array", "maxItems": 0},
    "hardware_commands_generated": {"const": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "waypoint_collision_sequence_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
