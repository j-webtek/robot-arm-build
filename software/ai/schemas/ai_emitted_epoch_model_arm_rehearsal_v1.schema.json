{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/ai_emitted_epoch_model_arm_rehearsal_v1.schema.json",
  "title": "RoCell AI-emitted epoch model-to-arm rehearsal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "batch_payload_sha256", "batch_sha256",
    "intent_plan_sha256", "ingress_sha256", "preplanner_gate_sha256",
    "planner_gate_v2_sha256", "measured_planner_status",
    "measured_planner_next_stage", "synthetic_rehearsal_report_sha256",
    "configuration_epoch_sha256", "preview_receipt_sha256", "command_count",
    "actual_ai_emitter_bytes_admitted", "synthetic_downstream_preview",
    "production_dispatch_allowed", "installation_authorized",
    "controller_start_authorized", "execution_authorized", "automatic_retry",
    "hardware_access", "physical_authority", "report_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.ai_emitted_epoch_model_arm_rehearsal.v1"},
    "status": {"const": "AI_BYTES_ADMITTED_PLANNER_BLOCKED_SYNTHETIC_PREVIEW_ONLY"},
    "batch_payload_sha256": {"$ref": "#/$defs/sha256"},
    "batch_sha256": {"$ref": "#/$defs/sha256"},
    "intent_plan_sha256": {"$ref": "#/$defs/sha256"},
    "ingress_sha256": {"$ref": "#/$defs/sha256"},
    "preplanner_gate_sha256": {"$ref": "#/$defs/sha256"},
    "planner_gate_v2_sha256": {"$ref": "#/$defs/sha256"},
    "measured_planner_status": {"const": "BLOCKED_CALIBRATION_MISSING_OR_STALE"},
    "measured_planner_next_stage": {"const": "COMMISSION_REQUIRED_CALIBRATIONS"},
    "synthetic_rehearsal_report_sha256": {"$ref": "#/$defs/sha256"},
    "configuration_epoch_sha256": {"$ref": "#/$defs/sha256"},
    "preview_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "command_count": {"type": "integer", "minimum": 1},
    "actual_ai_emitter_bytes_admitted": {"const": true},
    "synthetic_downstream_preview": {"const": true},
    "production_dispatch_allowed": {"const": false},
    "installation_authorized": {"const": false},
    "controller_start_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "automatic_retry": {"const": false},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
