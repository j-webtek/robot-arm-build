{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/r97_runtime_transition_assessment_v1.schema.json",
  "title": "RoCell r97 runtime transition assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "installed_surface_assessment",
    "arm064_receipt_sha256", "arm064_response_sha256", "r97_review_packet_sha256",
    "r97_review_manifest_sha256", "r97_app_sha256", "blockers", "next_dependency",
    "installation_intake_ready", "installation_authorized", "controller_start_authorized",
    "transport_authorized", "execution_authorized", "hardware_access",
    "physical_authority", "assessment_sha256"],
  "properties": {
    "schema": {"const": "rocell.r97_runtime_transition_assessment.v1"},
    "status": {"const": "BLOCKED"},
    "installed_surface_assessment": {"const": "DIAGNOSTIC_SURFACE_CONSISTENT_NOT_ATTESTED"},
    "arm064_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "arm064_response_sha256": {"$ref": "#/$defs/sha256"},
    "r97_review_packet_sha256": {"$ref": "#/$defs/sha256"},
    "r97_review_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "r97_app_sha256": {"$ref": "#/$defs/sha256"},
    "blockers": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["INSTALLED_RUNTIME_NOT_ATTESTED_AS_R97",
        "ACTIVE_FEEDBACK_SURFACE_REJECTED", "R97_INDEPENDENT_REVIEW_DECISION_MISSING",
        "MEASURED_CONFIGURATION_EPOCH_MISSING", "R97_CONFIGURATION_EPOCH_NULL"]}},
    "next_dependency": {"const": "EXTERNAL_R97_REVIEW_AND_EIGHT_COMPONENT_MEASURED_EPOCH"},
    "installation_intake_ready": {"const": false},
    "installation_authorized": {"const": false},
    "controller_start_authorized": {"const": false},
    "transport_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "assessment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
