{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactevra.local/schemas/residual_obstruction_v5_4_renderer_smoke_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "scope", "status", "source_commit", "fixture_file_sha256", "fixture_bundle_sha256", "renderer_file_sha256", "external_manifest_file_sha256", "external_manifest_dataset_sha256", "external_status_file_sha256", "metrics", "visual_audit", "campaign_render_authorized", "evaluation_render_authorized", "model_training_started", "hardware_writes", "physical_movements", "physical_authority", "limitations", "report_sha256"],
  "properties": {
    "schema": {"const": "tactevra.ai_residual_obstruction_v5_4_renderer_smoke.v1"},
    "scope": {"const": "SYNTHETIC_TRAINING_RENDERER_SMOKE_NO_QUALIFICATION"},
    "status": {"const": "PASS_RENDERER_PLUMBING_FULL_CAMPAIGN_BLOCKED_PENDING_ASSET_REALISM"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "fixture_file_sha256": {"$ref": "#/$defs/sha"}, "fixture_bundle_sha256": {"$ref": "#/$defs/sha"},
    "renderer_file_sha256": {"$ref": "#/$defs/sha"}, "external_manifest_file_sha256": {"$ref": "#/$defs/sha"},
    "external_manifest_dataset_sha256": {"$ref": "#/$defs/sha"}, "external_status_file_sha256": {"$ref": "#/$defs/sha"},
    "metrics": {"type": "object", "required": ["scene_count", "target_count", "appearance_count", "variant_count", "observation_count", "reference_count", "file_count", "unique_obstruction_asset_count", "overlap_ranges"]},
    "visual_audit": {"type": "object", "required": ["reviewed_variants", "pair_alignment", "coverage_progression", "finding"]},
    "campaign_render_authorized": {"const": false}, "evaluation_render_authorized": {"const": false},
    "model_training_started": {"const": false}, "hardware_writes": {"const": 0}, "physical_movements": {"const": 0}, "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
    "report_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
