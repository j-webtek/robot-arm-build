{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/measured_target_reprojection_v1.schema.json",
  "title": "RoCell measured target reprojection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "proposal_id", "proposal_sha256",
    "model_motion_candidate_sha256", "calibration_snapshot_sha256",
    "target_catalog_sha256", "source", "device", "target_id", "interaction",
    "speed_class", "input_target_mm", "input_frame_binding",
    "named_target_safe_rectangle_device_mm", "surface_plane_z_device_mm",
    "validated_target_device_mm", "measured_surface_target_board_mm",
    "measured_safe_polygon_board_mm", "requested_waypoints",
    "clearance_definition", "controller_commands", "hardware_commands_generated",
    "hardware_access", "physical_authority", "limitations", "reprojection_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.measured_target_reprojection.v1"},
    "status": {"const": "READY_FOR_DETERMINISTIC_IK_AND_ROUTE_SCREENING"},
    "proposal_id": {"type": "string", "minLength": 1},
    "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_motion_candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calibration_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object"},
    "device": {"enum": ["keyboard", "phone"]},
    "target_id": {"type": "string", "minLength": 1},
    "interaction": {"enum": ["HOVER", "CONTACT"]},
    "speed_class": {"enum": ["SLOW", "NOMINAL"]},
    "input_target_mm": {"$ref": "#/$defs/point"},
    "input_frame_binding": {"type": "object"},
    "named_target_safe_rectangle_device_mm": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number"}
    },
    "surface_plane_z_device_mm": {"type": "number"},
    "validated_target_device_mm": {"$ref": "#/$defs/point"},
    "measured_surface_target_board_mm": {"$ref": "#/$defs/point"},
    "measured_safe_polygon_board_mm": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/point"}
    },
    "requested_waypoints": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase", "point_mm"],
        "properties": {
          "phase": {"enum": ["HOVER_DESTINATION", "APPROACH", "CONTACT_CANDIDATE", "RETRACT"]},
          "point_mm": {"$ref": "#/$defs/point"}
        }
      }
    },
    "clearance_definition": {"const": "MEASURED_DEVICE_LOCAL_POSITIVE_Z"},
    "controller_commands": {"type": "array", "maxItems": 0},
    "hardware_commands_generated": {"const": 0},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reprojection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["frame", "x", "y", "z"],
      "properties": {
        "frame": {"type": "string", "minLength": 1},
        "x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}
      }
    }
  }
}
