{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "model_sha256",
    "target_catalog_sha256",
    "calibration_dataset_sha256",
    "evaluation_dataset_sha256",
    "qualification_sha256",
    "domain_id",
    "coverage_probability",
    "error_bound_mm",
    "target_ids"
  ],
  "properties": {
    "schema": {
      "const": "rocell.ai_localization_qualification.v0"
    },
    "scope": {
      "const": "SYNTHETIC_OFFLINE_ONLY"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_catalog_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calibration_dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluation_dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualification_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "domain_id": {
      "type": "string",
      "minLength": 1
    },
    "coverage_probability": {
      "type": "number",
      "minimum": 0.95,
      "exclusiveMaximum": 1
    },
    "error_bound_mm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
