{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/model_motion_sequence_journal_snapshot_v1.schema.json",
  "title": "RoCell durable model motion sequence journal snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "batch_sha256", "ingress_sha256", "action_count", "phase",
    "current_action_index", "event_count", "event_sha256", "head_sha256",
    "recovery_disposition", "automatic_retry_allowed", "hardware_access",
    "hardware_commands_generated", "snapshot_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.model_motion_sequence_journal_snapshot.v1"},
    "batch_sha256": {"$ref": "#/$defs/sha256"},
    "ingress_sha256": {"$ref": "#/$defs/sha256"},
    "action_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "phase": {"enum": ["SEQUENCE_CREATED", "ACTION_READY", "DISPATCH_BOUNDARY_COMMITTED", "ACTION_VERIFIED", "BLOCKED", "OUTCOME_UNCERTAIN", "COMPLETED"]},
    "current_action_index": {"type": "integer", "minimum": 0, "maximum": 63},
    "event_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "event_sha256": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/sha256"}},
    "head_sha256": {"$ref": "#/$defs/sha256"},
    "recovery_disposition": {"enum": ["RESUME_WITH_FRESH_STATE", "REEVALUATE_READY_ACTION_FROM_FRESH_STATE", "RETRY_FORBIDDEN_OUTCOME_UNCERTAIN", "COMPLETE_NO_ACTION", "TERMINAL_NO_ACTION"]},
    "automatic_retry_allowed": {"const": false},
    "hardware_access": {"const": false},
    "hardware_commands_generated": {"const": 0},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
