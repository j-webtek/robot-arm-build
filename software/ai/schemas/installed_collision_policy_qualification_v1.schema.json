{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rocell.local/schemas/installed_collision_policy_qualification_v1.schema.json",
  "title": "RoCell installed collision policy qualification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "qualification_id", "installed_collision_profile_sha256",
    "phase_local_contact_allowance_sha256",
    "physical_measurement_evidence_sha256",
    "independent_review_decision_sha256", "captured_monotonic_ns",
    "valid_until_monotonic_ns", "evidence_origin", "review_disposition",
    "execution_review_ready", "hardware_access", "physical_authority",
    "contact_authority", "qualification_sha256"
  ],
  "properties": {
    "schema": {"const": "rocell.installed_collision_policy_qualification.v1"},
    "qualification_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "installed_collision_profile_sha256": {"$ref": "#/$defs/hash"},
    "phase_local_contact_allowance_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "physical_measurement_evidence_sha256": {"$ref": "#/$defs/hash"},
    "independent_review_decision_sha256": {"$ref": "#/$defs/hash"},
    "captured_monotonic_ns": {"type": "integer", "minimum": 1},
    "valid_until_monotonic_ns": {"type": "integer", "minimum": 1},
    "evidence_origin": {"enum": ["PHYSICAL_RETAINED_ORIGINALS", "SYNTHETIC_TEST_ONLY"]},
    "review_disposition": {"enum": ["INDEPENDENTLY_APPROVED", "UNREVIEWED", "REJECTED"]},
    "execution_review_ready": {"type": "boolean"},
    "hardware_access": {"const": false},
    "physical_authority": {"const": false},
    "contact_authority": {"const": false},
    "qualification_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
